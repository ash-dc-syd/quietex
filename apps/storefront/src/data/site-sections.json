      },
      {
        "key": "accent",
        "label": "Second heading line",
        "kind": "text",
        "default": "Clear answers."
      },
      {
        "key": "body",
        "label": "Description",
        "kind": "textarea",
        "default": "Not sure where to start?\nWe’re happy to help."
      },
      {
        "key": "question1",
        "label": "Question 1",
        "kind": "text",
        "default": "Will acoustic panels soundproof my room?"
      },
      {
        "key": "answer1",
        "label": "Answer 1",
        "kind": "textarea",
        "default": "Acoustic panels help reduce echo and reflected sound inside a room. Soundproofing between rooms usually needs additional building treatments. Tell us what you’re trying to achieve and we can help you explore the options."
      },
      {
        "key": "question2",
        "label": "Question 2",
        "kind": "text",
        "default": "How do I choose the right panel?"
      },
      {
        "key": "answer2",
        "label": "Answer 2",
        "kind": "textarea",
        "default": "Start with the room, the surfaces you want to treat and the look you prefer. Send us your room dimensions and a few details about how you use the space, and we can discuss suitable panels."
      },
      {
        "key": "question3",
        "label": "Question 3",
        "kind": "text",
        "default": "Can I buy Quietex panels online?"
      },
      {
        "key": "answer3",
        "label": "Answer 3",
        "kind": "textarea",
        "default": "Quietex panels are currently sold through our retail partners, including Digital Cinema, Audio Junction and Instyle HiFi. Contact a retailer for pricing and availability, or send us a project enquiry."
      },
      {
        "key": "question4",
        "label": "Question 4",
        "kind": "text",
        "default": "Can panels be cut to fit?"
      },
      {
        "key": "answer4",
        "label": "Answer 4",
        "kind": "textarea",
        "default": "Panels can be cut to suit your layout. Check the product material, dimensions and installation requirements with us before cutting or fitting around corners, switches and power points."
      }
    ]
